{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/cv",
      "dest": "/khalid_osman_cv.pdf"
    },
    {
      "src": "/resume",
      "dest": "/resume_template.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
